{
  "name": "desktop-view",
  "displayName": "Desktop View",
  "description": "GitHub Desktop style history, changes and pull request viewer for the repositories in your workspace.",
  "version": "0.4.6",
  "publisher": "nazesaria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nazesaria/vscode-desktop-view.git"
  },
  "bugs": "https://github.com/nazesaria/vscode-desktop-view/issues",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:desktopView"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "desktopView.open",
        "title": "Open Repository...",
        "category": "Desktop View",
        "icon": "$(git-commit)"
      },
      {
        "command": "desktopView.openCurrent",
        "title": "Open Current Repository",
        "category": "Desktop View",
        "icon": "$(git-commit)"
      },
      {
        "command": "desktopView.openScmRepository",
        "title": "Open in Desktop View",
        "category": "Desktop View",
        "icon": "$(git-commit)"
      },
      {
        "command": "desktopView.signInGitHub",
        "title": "Sign in to GitHub",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.copySha",
        "title": "Copy SHA",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.openCommitOnGitHub",
        "title": "View on GitHub",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.copyPath",
        "title": "Copy Path",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.openFile",
        "title": "Open File",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.openDiffInEditor",
        "title": "Open Diff in Editor",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.revealInExplorer",
        "title": "Reveal in Explorer View",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.openPullRequestOnGitHub",
        "title": "View Pull Request on GitHub",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.discard",
        "title": "Discard Changes...",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.discardAll",
        "title": "Discard All Changes...",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.checkoutPullRequest",
        "title": "Checkout Pull Request",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.renameBranch",
        "title": "Rename...",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.deleteBranch",
        "title": "Delete...",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.copyBranchName",
        "title": "Copy Branch Name",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.discardSelected",
        "title": "Discard Selected Changes...",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.includeSelected",
        "title": "Include in Commit",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.excludeSelected",
        "title": "Exclude from Commit",
        "category": "Desktop View"
      },
      {
        "command": "desktopView.ctx.openFileAtRevision",
        "title": "Open File at This Version",
        "category": "Desktop View"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "desktopView.openCurrent",
          "when": "scmProvider == git",
          "group": "navigation@100"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "desktopView.openScmRepository",
          "when": "scmProvider == git",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "desktopView.openScmRepository",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.copySha",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.openCommitOnGitHub",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.copyPath",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.openFile",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.openDiffInEditor",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.revealInExplorer",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.openPullRequestOnGitHub",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.discard",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.discardAll",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.checkoutPullRequest",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.renameBranch",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.deleteBranch",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.copyBranchName",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.discardSelected",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.includeSelected",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.excludeSelected",
          "when": "false"
        },
        {
          "command": "desktopView.ctx.openFileAtRevision",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "desktopView.ctx.copySha",
          "when": "webviewId == desktopView && webviewSection == commit",
          "group": "1_copy@1"
        },
        {
          "command": "desktopView.ctx.openCommitOnGitHub",
          "when": "webviewId == desktopView && webviewSection == commit && desktopViewGitHub",
          "group": "2_open@1"
        },
        {
          "command": "desktopView.ctx.openFile",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewLocalFile && !desktopViewMulti",
          "group": "2_open@1"
        },
        {
          "command": "desktopView.ctx.openDiffInEditor",
          "when": "webviewId == desktopView && webviewSection == file && !desktopViewMulti",
          "group": "2_open@3"
        },
        {
          "command": "desktopView.ctx.revealInExplorer",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewLocalFile && !desktopViewMulti",
          "group": "2_open@4"
        },
        {
          "command": "desktopView.ctx.copyPath",
          "when": "webviewId == desktopView && webviewSection == file",
          "group": "1_copy@1"
        },
        {
          "command": "desktopView.ctx.openPullRequestOnGitHub",
          "when": "webviewId == desktopView && webviewSection == pullRequest",
          "group": "2_open@1"
        },
        {
          "command": "desktopView.ctx.discard",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewWorking && !desktopViewMulti",
          "group": "3_discard@1"
        },
        {
          "command": "desktopView.ctx.discardAll",
          "when": "webviewId == desktopView && (webviewSection == changesHeader || webviewSection == file && desktopViewWorking)",
          "group": "3_discard@2"
        },
        {
          "command": "desktopView.ctx.checkoutPullRequest",
          "when": "webviewId == desktopView && webviewSection == pullRequest",
          "group": "1_checkout@1"
        },
        {
          "command": "desktopView.ctx.copyBranchName",
          "when": "webviewId == desktopView && webviewSection == branch",
          "group": "1_copy@1"
        },
        {
          "command": "desktopView.ctx.renameBranch",
          "when": "webviewId == desktopView && webviewSection == branch && !desktopViewRemoteBranch",
          "group": "2_edit@1"
        },
        {
          "command": "desktopView.ctx.deleteBranch",
          "when": "webviewId == desktopView && webviewSection == branch && !desktopViewRemoteBranch && !desktopViewCurrentBranch",
          "group": "2_edit@2"
        },
        {
          "command": "desktopView.ctx.discardSelected",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewWorking && desktopViewMulti",
          "group": "3_discard@1"
        },
        {
          "command": "desktopView.ctx.includeSelected",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewWorking",
          "group": "4_commit@1"
        },
        {
          "command": "desktopView.ctx.excludeSelected",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewWorking",
          "group": "4_commit@2"
        },
        {
          "command": "desktopView.ctx.openFileAtRevision",
          "when": "webviewId == desktopView && webviewSection == file && desktopViewRevision && !desktopViewMulti",
          "group": "2_open@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "desktopView.openCurrent",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "configuration": {
      "title": "Desktop View",
      "properties": {
        "desktopView.historyPageSize": {
          "type": "number",
          "default": 100,
          "description": "How many commits to load at a time in the History tab."
        },
        "desktopView.diffContextLines": {
          "type": "number",
          "default": 3,
          "description": "Context lines around each change in local diffs."
        },
        "desktopView.colors": {
          "type": "string",
          "enum": [
            "desktop",
            "theme"
          ],
          "default": "desktop",
          "enumDescriptions": [
            "GitHub Desktop's colors (its dark or light theme, following VS Code's theme kind).",
            "The colors of the current VS Code theme."
          ],
          "description": "Color palette of the Desktop View tabs. High contrast themes always use the theme colors."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "node esbuild.mjs --tests && node --test out-test/",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/vscode": "1.90",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.24.2",
    "highlight.js": "11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.6"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
